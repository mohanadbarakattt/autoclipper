# Virlo Studio (hosted AutoClipper). Copy to saas.env (gitignored) and fill in. Never commit real keys.

# ---------- AI (paid keys: required to serve other people) ----------
# Gemini API key from a Google Cloud project WITH billing on (paid tier: inputs aren't used for training)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# low = ~3x fewer video tokens per moment
GEMINI_MEDIA_RESOLUTION=low
# Anthropic API key for Claude's final check (paid plans). Model alias: sonnet | opus | haiku or a full model id
ANTHROPIC_API_KEY=
CLAUDE_MODEL=sonnet

# ---------- Optional platform apps (better signals, free) ----------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---------- App ----------
SAAS_PORT=8100
# 0.0.0.0 behind a reverse proxy / Cloudflare Tunnel; 127.0.0.1 for local dev
SAAS_HOST=127.0.0.1
# 1 when served over HTTPS
SAAS_COOKIE_SECURE=0
# where accounts + user workspaces live (default: ./saas_data)
SAAS_DATA_DIR=
SAAS_SCAN_MINUTES=30
# parallel engine runs (default: CPU cores / 4)
SAAS_MAX_PARALLEL_JOBS=
WHISPER_DEVICE=cpu
X264_PRESET=veryfast

# ---------- Clips inside Virlo Studio (docs/VIRLO_INTEGRATION.md) ----------
# service = only the API for Virlo Studio (no standalone pages); app = standalone site
SAAS_MODE=service
# virlo = clips are paid in Virlo Studio points; local = this app's own plans
BILLING=virlo
# long random string shared with Virlo Studio (same value as CLIPS_SERVICE_TOKEN on Vercel)
CLIPS_SERVICE_TOKEN=
# signs media links for browsers (defaults to the service token)
SAAS_MEDIA_SECRET=
# public base URL of this service, used in media links
SAAS_PUBLIC_URL=https://clips-api.virlo.studio
VIRLO_URL=https://virlo.studio
