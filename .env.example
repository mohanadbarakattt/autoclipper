# ---------- AI (both free) ----------
# Free Gemini key, no billing needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude uses YOUR existing Claude Pro/Max subscription through Claude Code (no API key, no extra cost).
# Easy mode (start.bat): just install Claude Code and log in once by running `claude`. Leave this empty.
# Docker mode only: run `claude setup-token` and paste the long-lived token here.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=sonnet
# auto = Claude if available, else Gemini | claude | gemini
SCORER=auto

# ---------- Optional free platform apps (better signals) ----------
# https://dev.twitch.tv/console/apps  (enables category filter + viewer-clip clusters)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# https://kick.com/settings/developer  (enables Kick live status + category)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---------- TryPost (self-hosted, free) ----------
# Inside docker compose the clipper reaches TryPost by service name:
TRYPOST_API_URL=http://trypost
# TryPost -> Settings -> API -> Generate API Key
TRYPOST_API_KEY=

# ---------- Tuning ----------
DASHBOARD_PORT=8090
VOD_POLL_MINUTES=30
KEEP_PUBLISHED_DAYS=7
WHISPER_DEVICE=cpu
X264_PRESET=medium
LOG_LEVEL=INFO

# ---------- Clip export + schedule ----------
# Finished clips + caption files are copied here, one folder per posting day (Google Drive for desktop folder)
EXPORT_DIR=G:\My Drive\AutoClipper
# Times shown in file names / schedule, and your local time in the caption file
SCHEDULE_TIMEZONE=America/New_York
LOCAL_TIMEZONE=Africa/Cairo
