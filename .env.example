# ---------- AI (both free) ----------
# Free Gemini key, no billing needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude uses YOUR existing Claude Pro/Max subscription through Claude Code (no API key, no extra cost).
# Easy mode (start.bat): just install Claude Code and log in once by running `claude`. Leave this empty.
# Docker mode only: run `claude setup-token` and paste the long-lived token here.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=sonnet
# auto = Claude if available, else Gemini | claude | gemini
SCORER=auto

# ---------- Optional free platform apps (better signals) ----------
# https://dev.twitch.tv/console/apps  (enables category filter + viewer-clip clusters)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# https://kick.com/settings/developer  (enables Kick live status + category)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---------- TryPost (self-hosted, free) ----------
# Inside docker compose the clipper reaches TryPost by service name:
TRYPOST_API_URL=http://trypost
# TryPost -> Settings -> API -> Generate API Key
TRYPOST_API_KEY=
# Docker only: TryPost's ports (8000, 8081) answer on this computer only. A Cloudflare Tunnel or ngrok
# still works. To reach them from your network, change its default password first, then remove the #:
# TRYPOST_HOST=0.0.0.0

# ---------- Tuning ----------
DASHBOARD_PORT=8090
# The dashboard has NO password. By default only this computer can open it (127.0.0.1).
# To open it from your phone or another PC, remove the # below. Only do that on a network you trust:
# anyone who can reach it can watch and delete clips and change your streamers and profiles.
# DASHBOARD_HOST=0.0.0.0
# Other websites can't use the dashboard: it only answers to IP addresses and names it knows (localhost, this
# computer's name, and local names like mypc.local once opened above). Opening it under another name (reverse
# proxy, Tailscale, router DNS name)? List it here, comma separated:
# DASHBOARD_ALLOWED_HOSTS=clips.example.com
VOD_POLL_MINUTES=30
KEEP_PUBLISHED_DAYS=7
WHISPER_DEVICE=cpu
X264_PRESET=medium
LOG_LEVEL=INFO

# ---------- Clip export + schedule ----------
# Finished clips + caption files are copied here, one folder per posting day (Google Drive for desktop folder)
# e.g. EXPORT_DIR=G:\My Drive\AutoClipper   (leave empty to keep clips only in data/ready_clips)
EXPORT_DIR=
# Times shown in file names / schedule, and your local time in the caption file
SCHEDULE_TIMEZONE=America/New_York
# Your own timezone for the caption file, e.g. Europe/London. Empty = this PC's timezone.
LOCAL_TIMEZONE=

# ---------- Capacity / scoring ----------
# Max live streams recorded at once (your own channels always record; auto-found ones fill the rest)
MAX_LIVE_RECORDINGS=4
MAX_AUTO_STREAMERS=6
DISCOVER_MINUTES=60
# Claude only gives the final word on clips Gemini scored at least this high (default: profile min_viral_score)
CLAUDE_FINAL_MIN=

# off = never record live streams (saves ~6-8 Mbps of internet per stream); clips come only from finished streams
LIVE_RECORDING=on

# ---------- Guardrails (daily budgets, reset at midnight; 0 = no limit) ----------
MAX_CLIPS_PER_DAY=15
MAX_AI_CHECKS_PER_DAY=200
MAX_CLAUDE_CHECKS_PER_DAY=25
MAX_DOWNLOAD_GB_PER_DAY=2
MAX_STORAGE_GB=20
MIN_FREE_DISK_GB=15
MAX_PENDING=40
