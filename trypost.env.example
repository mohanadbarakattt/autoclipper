# Self-hosted TryPost settings. scripts/setup.py fills the secrets for you.
APP_NAME=TryPost
APP_ENV=production
APP_DEBUG=false
# Public HTTPS URL of TryPost (Cloudflare Tunnel / ngrok static domain). Needed for OAuth callbacks.
APP_URL=https://post.example.com
SELF_HOSTED=true
APP_KEY=
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=trypost
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
REVERB_APP_KEY=trypost-reverb-key
REVERB_APP_SECRET=

# Callback URLs to register in each developer console:
#   ${APP_URL}/accounts/youtube/callback   ${APP_URL}/accounts/instagram/callback   ${APP_URL}/accounts/tiktok/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT="${APP_URL}/accounts/youtube/callback"
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_REDIRECT="${APP_URL}/accounts/instagram/callback"
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_REDIRECT="${APP_URL}/accounts/tiktok/callback"
